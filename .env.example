# Copy this file to .env and set values from your Supabase project.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Public values are embedded into the Next.js browser bundle at build time.
# For an IP-based URL, use the IP address clients will use to reach Ubuntu.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

